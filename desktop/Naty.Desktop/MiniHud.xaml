<Window x:Class="Naty.Desktop.MiniHud"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="180" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
  <Border Background="#F2071426" BorderBrush="#18BFFF" BorderThickness="1" CornerRadius="18" Padding="20">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
        <TextBlock Text="NATY" FontSize="16" FontWeight="SemiBold" Foreground="#EAF4FF" />
        <TextBlock x:Name="StateText" Text="IDLE" FontFamily="Cascadia Mono" Foreground="#31E6A1" HorizontalAlignment="Right" />
      </DockPanel>
      <TextBlock x:Name="ResponseText" Grid.Row="1" Text="O que você precisa?" Foreground="#8CA6C5"
                 TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14" />
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="InputBox" Background="#0B192D" Foreground="#EAF4FF" BorderBrush="#17466C" Padding="10,7"
                 KeyDown="InputBox_KeyDown" />
        <Button Grid.Column="1" Content="Expandir" Margin="10,0,0,0" Click="Expand_Click" />
      </Grid>
    </Grid>
  </Border>
</Window>
