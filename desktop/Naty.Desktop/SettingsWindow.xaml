<Window x:Class="Naty.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações da NATY" Width="820" Height="680" MinWidth="720" MinHeight="560"
        Background="{StaticResource BgMain}" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#071426"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="9,7"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#071426"/><Setter Property="Foreground" Value="#071426"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Margin" Value="0,7"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Margin" Value="0,12,0,4"/></Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <TextBlock Text="CONFIGURAÇÕES" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="StatusText" Text="Carregando…" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </DockPanel>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}">
      <TabItem Header="Geral">
        <ScrollViewer><StackPanel Margin="22" MaxWidth="650" HorizontalAlignment="Left">
          <CheckBox x:Name="StartWithWindows" Content="Iniciar com Windows"/>
          <CheckBox x:Name="CloseToTray" Content="Fechar para a bandeja"/>
          <CheckBox x:Name="DailyBriefing" Content="Preparar briefing diário (notificação discreta)"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Horário do briefing"/><TextBox x:Name="DailyBriefingTime" Width="360"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Hotkey"/><TextBox x:Name="Hotkey" Width="360"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Idioma"/><ComboBox x:Name="InterfaceLanguage" Width="360"><ComboBoxItem Content="pt-BR"/></ComboBox>
          <Button Content="Gerenciar modos / workspaces" Click="Workspaces_Click" Width="230" Margin="0,18,0,0"/>
          <TextBlock Text="Algumas mudanças entram em vigor na próxima inicialização." Foreground="{StaticResource TextMuted}" Margin="0,18,0,0"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="VoiceTab" Header="Voz">
        <ScrollViewer><StackPanel Margin="22">
          <TextBlock Text="1. Microfone" FontSize="18" FontWeight="SemiBold"/>
          <ComboBox x:Name="MicrophonePicker" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,8,0,0"/>
          <TextBlock x:Name="MicrophoneStatus" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,14"/>

          <TextBlock Text="2. Reconhecimento" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Whisper Base" Margin="0,8,0,0"/>
          <TextBlock x:Name="WhisperStatus" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,8"/>
          <WrapPanel><Button x:Name="InstallSttButton" Content="Instalar" Click="InstallStt_Click" Margin="0,0,8,0"/><Button Content="Reparar" Click="RepairStt_Click"/></WrapPanel>

          <Separator Margin="0,18"/>
          <TextBlock Text="3. Voz" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Provider atual"/><ComboBox x:Name="TtsProvider"><ComboBoxItem Content="piper"/><ComboBoxItem Content="sapi"/></ComboBox>
          <TextBlock x:Name="PiperStatus" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,8"/>
          <WrapPanel><Button Content="Configurar Piper" Click="InstallTts_Click" Margin="0,0,8,0"/><Button Content="Reparar" Click="RepairTts_Click" Margin="0,0,8,0"/><Button Content="Testar voz" Tag="tts" Click="VoiceTest_Click"/></WrapPanel>

          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Velocidade"/><TextBox x:Name="VoiceRate" Margin="0,0,8,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="Volume (0–100)"/><TextBox x:Name="VoiceVolume" Margin="0,0,8,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource FieldLabel}" Text="Follow-up (s)"/><TextBox x:Name="Followup"/></StackPanel>
          </Grid>
          <Button Content="TESTAR NATY" Click="VoiceTest_Click" Margin="0,20,0,8" Padding="12" Background="#123B5A"/>
          <Button Content="Teste de precisão (10 frases)" Click="PrecisionTest_Click" HorizontalAlignment="Left"/>

          <Expander Header="Detalhes avançados" Margin="0,18,0,0" Foreground="{StaticResource TextSecondary}">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Whisper executável"/><TextBox x:Name="WhisperExecutable"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Whisper modelo"/><TextBox x:Name="WhisperModel"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Piper executável"/><TextBox x:Name="PiperExecutable"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Piper modelo"/><TextBox x:Name="PiperModel"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="Piper configuração"/><TextBox x:Name="PiperConfig"/>
            </StackPanel>
          </Expander>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Integrações">
        <ScrollViewer><StackPanel Margin="22">
          <TextBlock FontSize="18" Text="Google"/><TextBlock x:Name="GoogleStatus" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,8"/><CheckBox x:Name="GoogleEnabled" Content="Integração Google habilitada"/>
          <Separator Margin="0,14"/><TextBlock FontSize="18" Text="ChatGPT"/><CheckBox x:Name="ChatGptHandoff" Content="Handoff pelo navegador habilitado"/>
          <Separator Margin="0,14"/><TextBlock FontSize="18" Text="Obsidian"/><TextBlock x:Name="ObsidianStatus" Foreground="{StaticResource TextSecondary}"/>
          <CheckBox x:Name="ObsidianEnabled" Content="Obsidian habilitado"/><TextBlock Style="{StaticResource FieldLabel}" Text="Vault"/><TextBox x:Name="ObsidianVault"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta gerenciada NATY"/><TextBox x:Name="NatyObsidian"/>
          <Separator Margin="0,14"/><TextBlock FontSize="18" Text="Spotify"/><TextBlock Text="Launcher e controles de mídia locais; nenhuma credencial armazenada." Foreground="{StaticResource TextSecondary}"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Sincronização">
        <ScrollViewer><StackPanel Margin="22">
          <CheckBox x:Name="SyncEnabled" Content="Sincronização por eventos habilitada"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Nome deste dispositivo"/><TextBox x:Name="DeviceName"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta NatySync"/><TextBox x:Name="SyncFolder"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Device ID"/><TextBlock x:Name="DeviceId" FontFamily="Cascadia Mono" TextWrapping="Wrap"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Estado"/><TextBlock x:Name="SyncStatus"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Último sync"/><TextBlock x:Name="LastSync"/>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Fila"/><TextBlock x:Name="SyncCounts"/>
          <WrapPanel Margin="0,20,0,0"><Button Content="Sincronizar agora" Click="SyncNow_Click" Margin="0,0,8,0"/><Button Content="Abrir conflitos" Click="OpenConflicts_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Memória e privacidade">
        <ScrollViewer><StackPanel Margin="22">
          <TextBlock Style="{StaticResource FieldLabel}" Text="Learning mode"/><ComboBox x:Name="LearningMode"><ComboBoxItem Content="manual"/><ComboBoxItem Content="assisted"/><ComboBoxItem Content="automatic_safe"/></ComboBox>
          <TextBlock Style="{StaticResource FieldLabel}" Text="Proatividade"/><ComboBox x:Name="Proactivity"><ComboBoxItem Content="off"/><ComboBoxItem Content="important"/><ComboBoxItem Content="assistant"/></ComboBox>
          <CheckBox x:Name="QuietHours" Content="Ativar horário silencioso"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Style="{StaticResource FieldLabel}" Text="Início"/><TextBox x:Name="QuietHoursStart" Margin="0,0,8,0"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource FieldLabel}" Text="Fim"/><TextBox x:Name="QuietHoursEnd"/></StackPanel>
          </Grid>
          <CheckBox x:Name="PrivacyMode" Content="Modo de privacidade"/>
          <WrapPanel Margin="0,20,0,0"><Button Content="Abrir pasta de memória" Click="OpenMemory_Click" Margin="0,0,8,0"/><Button Content="Abrir Evolução da NATY" Click="OpenEvolution_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Sobre">
        <ScrollViewer><StackPanel Margin="22"><TextBlock Text="NATY" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Versão 3 · Desktop WPF + Core Python" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,20"/>
          <TextBlock x:Name="AboutStatus" TextWrapping="Wrap" LineHeight="25"/>
          <WrapPanel Margin="0,20,0,0"><Button Content="Executar diagnóstico" Click="RunDiagnostics_Click" Margin="0,0,8,0"/><Button Content="Copiar detalhes técnicos" Click="CopyDiagnostics_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="Cancelar" Click="Cancel_Click" HorizontalAlignment="Right" Margin="8,0,0,0"/><Button Content="Salvar" Click="Save_Click" HorizontalAlignment="Right" Background="#123B5A"/></DockPanel>
  </Grid>
</Window>
